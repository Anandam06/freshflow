FRESHFLOW_ENV=development
FRESHFLOW_DB=data/freshflow.sqlite
# Render sets DATABASE_URL from managed PostgreSQL. It takes precedence over SQLite.
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
FRESHFLOW_OPERATOR_KEY=
# Live agent (Anthropic Claude). Leave the key empty to run only the deterministic agent.
FRESHFLOW_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
