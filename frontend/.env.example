# FreshFlow frontend configuration. All VITE_* values are PUBLIC (compiled into the bundle):
# never put the operator key, OpenAI keys or any other secret here.

# Origin of the FastAPI backend, no trailing slash, no /api/v1 suffix.
# Example: https://freshflow-api.onrender.com
VITE_API_BASE_URL=

# "true" forces the in-browser demo adapter (replayed backend responses, always labelled "Demo data").
# With an empty VITE_API_BASE_URL the app also uses demo mode. Never use demo mode for the final deployment.
VITE_USE_MOCK=false

# Optional: id of a stored simulation run (POST /api/v1/simulations -> id) to show on first load.
# Public visitors cannot POST without the operator key, and a default run takes ~40 s,
# so production should pin a pre-computed baseline that loads via the public GET.
VITE_BASELINE_SIMULATION_ID=
